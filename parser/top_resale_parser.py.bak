"""
Top re:sale parser - Block-based parsing with section headers
Format:
  Header: "MacBook Air 13 (M2)" -> applies to all lines below
  Line: "🇺🇸 MC7X4 – 16/256 Midnight — 69000₽" -> parsed with header context
"""
import re
import structlog
from datetime import datetime
from typing import Optional, List, Tuple, Dict
from common.models import RawMessage, ParsedProduct

logger = structlog.get_logger(__name__)


class TopResaleParser:
    """Block-based parser for Top re:sale Telegram channel"""

    # Country to SIM type mapping
    COUNTRY_SIM = {
        '🇧🇭': 'esim', '🇨🇦': 'esim', '🇬🇺': 'esim', '🇯🇵': 'esim', '🇰🇼': 'esim',
        '🇲🇽': 'esim', '🇴🇲': 'esim', '🇶🇦': 'esim', '🇸🇦': 'esim', '🇦🇪': 'esim',
        '🇺🇸': 'esim', '🇻🇮': 'esim',
        '🇪🇺': 'sim+esim', '🇮🇳': 'sim+esim', '🇻🇳': 'sim+esim', '🇦🇺': 'sim+esim',
        '🇳🇿': 'sim+esim', '🇰🇷': 'sim+esim', '🇸🇬': 'sim+esim', '🇭🇰': 'sim+esim',
        '🇨🇳': '2sim', '🇷🇺': 'sim+esim', '🇰🇿': 'sim+esim', '🇮🇩': 'sim+esim',
        '🇹🇭': 'sim+esim', '🇵🇭': 'sim+esim', '🇲🇾': 'sim+esim', '🇵🇦': 'sim+esim',
        '🇨🇱': 'sim+esim', '🇿🇦': 'sim+esim', '🇬🇧': 'sim+esim', '🇮🇱': 'sim+esim',
        '🇹🇼': 'sim+esim', '🇹🇷': 'sim+esim', '🇧🇷': 'sim+esim', '🇮🇹': 'sim+esim',
        '🇩🇪': 'sim+esim', '🇫🇷': 'sim+esim', '🇪🇸': 'sim+esim', '🇵🇹': 'sim+esim',
        '🇵🇱': 'sim+esim', '🇸🇪': 'sim+esim', '🇳🇴': 'sim+esim', '🇩🇰': 'sim+esim',
        '🇫🇮': 'sim+esim'
    }

    FLAG_PATTERN = r'(🇧🇭|🇨🇦|🇬🇺|🇯🇵|🇰🇼|🇲🇽|🇴🇲|🇶🇦|🇸🇦|🇦🇪|🇺🇸|🇻🇮|🇪🇺|🇮🇳|🇻🇳|🇦🇺|🇳🇿|🇰🇷|🇸🇬|🇭🇰|🇨🇳|🇷🇺|🇰🇿|🇮🇩|🇹🇭|🇵🇭|🇲🇾|🇵🇦|🇨🇱|🇿🇦|🇬🇧|🇮🇱|🇹🇼|🇹🇷|🇧🇷|🇮🇹|🇩🇪|🇫🇷|🇪🇸|🇵🇹|🇵🇱|🇸🇪|🇳🇴|🇩🇰|🇫🇮)'

    COLORS = [
        'black', 'white', 'blue', 'pink', 'green', 'yellow', 'purple', 'red',
        'lavender', 'lavander', 'sage', 'starlight', 'midnight', 'natural', 'desert',
        'cosmic', 'orange', 'silver', 'gold', 'ultramarine', 'teal', 'gray',
        'citrus', 'indigo', 'blush', 'space gray', 'rose gold', 'sky blue',
        'space black', 'vinca', 'patina', 'jasper', 'plum', 'graphite', 'olive',
        'mint', 'navy', 'nickel', 'copper', 'amber', 'silk', 'velvet', 'cyan',
        'prussian blue', 'strawberry bronze', 'onyx', 'pop', 'apricot', 'topaz',
        'red velvet', 'rich copper', 'amber silk', 'ceramic pink', 'ceramic patina'
    ]

    COLOR_NORMALIZE = {
        'lavander': 'lavender',
        'spacegray': 'space gray',
        'spaceblack': 'space black',
        'rosegold': 'rose gold',
        'skyblue': 'sky blue',
        'blue copper': 'blue',
        'nickel copper': 'silver',
        'prussian blue': 'blue',
        'vinca blue': 'blue',
        'rich copper': 'copper',
    }

    def __init__(self):
        self.categories = {}

    def parse(self, raw_message: RawMessage) -> List[ParsedProduct]:
        """Parse message using block-based approach"""
        products = []
        text = raw_message.text.strip()

        # Skip entire message if it's ASIS
        if self._is_asis_message(text):
            logger.debug(f"⚠️ Skipping ASIS/used message: {raw_message.id}")
            return []

        # Split into blocks by headers
        blocks = self._split_into_blocks(text)
        
        # Parse each block
        for header, lines in blocks:
            for line in lines:
                line_stripped = line.strip()
                if not line_stripped:
                    continue
                
                product = self._parse_line(line_stripped, raw_message, header)
                if product:
                    products.append(product)

        return products

    def _split_into_blocks(self, text: str) -> List[Tuple[str, List[str]]]:
        """Split text into blocks based on headers"""
        blocks = []
        current_header = ""
        current_lines = []
        
        for line in text.split('\n'):
            line_stripped = line.strip()
            
            # Check if this is a header line
            header_info = self._parse_header(line_stripped)
            
            if header_info:
                # Save previous block if exists
                if current_lines:
                    blocks.append((current_header, current_lines))
                # Start new block
                current_header = header_info
                current_lines = []
            elif line_stripped and not self._is_skip_line(line_stripped):
                # Add to current block
                current_lines.append(line_stripped)
        
        # Save last block
        if current_lines:
            blocks.append((current_header, current_lines))
        
        return blocks

    def _parse_header(self, line: str) -> Optional[str]:
        """
        Parse header line and return normalized header string.
        Returns None if not a header.
        """
        line_lower = line.lower()
        
        # Skip if line has price or flag - it's a product line
        if ('₽' in line or 'руб' in line.lower() or '—' in line or '–' in line) and re.search(self.FLAG_PATTERN, line):
            return None
        
        # Skip metadata lines
        if any(kw in line_lower for kw in ['оформление', 'менеджер', 'условия', 'отзывы', 'отправки', 'faq', 'http', 't.me/', '@', '⁉️', '🔝', '👻', '💬']):
            return None
        
        # === iPhone headers ===
        if re.match(r'iphone\s*\d{0,2}\s*(pro|max,plus,air,e)?\s*[:\s]?', line_lower):
            return line.strip().rstrip(':')
        
        # === MacBook headers ===
        if re.match(r'macbook\s*(air|pro|neo)?\s*\d{0,2}\s*\(?m\d{1,2}\)?', line_lower):
            return line.strip()
        
        # === iPad headers ===
        if re.match(r'(ipad\s*(air|pro|mini)?)\s*\d{0,2}', line_lower) and 'ipad' in line_lower:
            return line.strip()
        
        # === Apple Watch headers ===
        if re.match(r'apple\s*watch\s*(se|s|ultra)?\s*\d{0,2}', line_lower):
            return line.strip()
        
        # === Samsung headers ===
        if re.match(r's\d{2}\s*(fe|ultra|\+)?\s*[:\s]?', line_lower):
            return line.strip()
        
        # === Dyson headers ===
        dyson_patterns = ['стайлеры', 'фены', 'беспроводные пылесосы', 'проводные пылесосы', 'прочие модели', 'моющие']
        if any(kw in line_lower for kw in dyson_patterns):
            return line.strip()
        
        # === PS5 headers ===
        if 'ps5' in line_lower or re.match(r'ps5\s*(pro|slim|vr)?\s*\d{0,3}?', line_lower):
            return line.strip()
        
        # === AirPods headers ===
        if 'airpods' in line_lower and 'max' not in line_lower:
            return line.strip()
        
        return None

    def _is_asis_message(self, text: str) -> bool:
        """Check if entire message is ASIS/used"""
        asis_keywords = [
            'обменки', 'без коробки', 'с коробки', 'активирован',
            'асис', 'б/у', 'refurbished', 'запак', 'asis'
        ]
        text_lower = text.lower()
        return any(kw in text_lower for kw in asis_keywords)

    def _is_skip_line(self, line: str) -> bool:
        """Check if line should be skipped"""
        line_lower = line.lower()
        
        # Skip dates
        if re.match(r'\d{2}/\d{2}/\d{2}', line):
            return True
        
        # Skip metadata
        skip_patterns = [
            'оформление', 'менеджер', 'условия', 'отзывы', 'отправки',
            'faq', 'http', 't.me/', '@', '⁉️', '🔝', '👻', '💬'
        ]
        if any(p in line_lower for p in skip_patterns):
            return True
        
        # Skip headers (lines ending with : and short)
        if line.rstrip().endswith(':') and len(line) < 100:
            return True
        
        # Skip empty or too short
        if len(line.strip()) < 5:
            return True
        
        return False

    def _parse_line(self, line: str, raw_message: RawMessage, header: str = "") -> Optional[ParsedProduct]:
        """Parse a single product line with header context"""
        line_stripped = line.strip()
        
        # Combine header and line for context
        full_context = f"{header} {line_stripped}" if header else line_stripped
        full_context_lower = full_context.lower()

        # Extract flag first
        flag = self._extract_flag(line_stripped)
        if not flag:
            # Try to extract from header context
            flag = self._extract_flag(full_context)
        
        if not flag:
            return None

        sim_type = self.COUNTRY_SIM.get(flag, 'unknown')

        # Check for /DS (Dual SIM)
        if '/ds' in full_context_lower:
            sim_type = '2sim'

        # Extract price
        price = self._extract_price(full_context)
        if not price:
            return None

        # Determine category and brand from full context
        category_id, brand = self._determine_category(full_context)
        if not category_id:
            return None

        # Extract model
        model = self._extract_model(full_context, category_id, brand, header)
        if not model:
            return None

        # Extract attributes
        storage = self._extract_storage(full_context)
        color = self._extract_color(full_context)

        # Build attributes dict
        attributes = {}
        if storage:
            attributes['storage'] = storage
        if color:
            attributes['color'] = color.capitalize()
        if sim_type:
            attributes['sim_type'] = sim_type

        # Generate unique ID
        line_hash = hash(line_stripped) & 0xffffffff
        product_id = f"prod_{raw_message.id}_{line_hash}_{int(datetime.utcnow().timestamp())}"
        unique_message_link = f"{raw_message.message_link}?line={line_hash}"

        return ParsedProduct(
            id=product_id,
            category_id=category_id,
            brand=brand.lower(),
            model=model,
            price=price,
            source_channel=raw_message.channel_id,
            message_link=unique_message_link,
            timestamp=raw_message.timestamp,
            attributes=attributes,
            raw_message_id=raw_message.id
        )

    def _determine_category(self, line: str) -> Tuple[Optional[str], str]:
        """Determine category and brand from line"""
        line_lower = line.lower()

        # Dyson - check FIRST
        if 'dyson' in line_lower or re.search(r'\b(hs|hd|v)\d{2,3}', line_lower):
            return 'accessories', 'dyson'

        # PS5
        if 'ps5' in line_lower:
            return 'consoles', 'sony'

        # MacBook
        if 'macbook' in line_lower:
            return 'laptops', 'apple'

        # iPad
        if 'ipad' in line_lower:
            return 'tablets', 'apple'

        # Samsung S-series and A-series
        if re.search(r'\b(s\d{2}\s*ultra|s\d{2}\+|s\d{2}|a0\d|a1\d|a2\d|a3\d|a5\d|z\s*(fold|flip)\s*\d)\b', line_lower):
            return 'smartphones', 'samsung'

        # Apple Watch
        if 'apple watch' in line_lower:
            return 'accessories', 'apple'
        if re.search(r'\b(se2|se3)\b', line_lower):
            return 'accessories', 'apple'
        if re.search(r's\d{1}\s*mm', line_lower):
            return 'accessories', 'apple'
        if re.search(r'watch\s+ultra\s*\d', line_lower):
            return 'accessories', 'apple'
        if re.search(r'\bultra\s*\d', line_lower) and not re.search(r's\d{2}\s+ultra', line_lower):
            return 'accessories', 'apple'

        # AirPods
        if 'airpods' in line_lower:
            return 'accessories', 'apple'

        # iPhone
        if re.search(r'iphone\s*\d+', line_lower):